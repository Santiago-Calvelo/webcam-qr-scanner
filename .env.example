# Configuración del escáner de QR.
# Copiá este archivo a .env y completá los valores.

# URL base de la API de sage-gestion
SAGE_API_URL=http://localhost:3000

# Secreto compartido entre el escáner y la API de sage.
# Debe ser IGUAL al valor de SCANNER_SHARED_SECRET en el .env de la API.
SCANNER_SHARED_SECRET=cambiame-por-un-secreto-largo

# Puerto del servidor del escáner (opcional, default 8080)
# PORT=8080
